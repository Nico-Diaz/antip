---
import Layout from "../layouts/Layout.astro";
import { isUserAdmin } from "../lib/auth";

const user = Astro.locals.user;
const accessToken = Astro.cookies.get('sb-access-token')?.value;
const isAdmin = await isUserAdmin(user, accessToken);

if (!user || !isAdmin) {
  return Astro.redirect('/dashboard');
}
---

<Layout>
  <main class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-8">
      
      <!-- Header de Administración -->
      <div class="bg-[#06203D] rounded-2xl shadow-md border border-slate-800 p-6 sm:p-8 text-white flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold text-white">Panel de Administración</h1>
            <span class="bg-[#0073CF] text-white text-xs font-semibold px-3 py-1 rounded-full border border-blue-400/30">
              Gestión de Contenido
            </span>
          </div>
          <p class="text-slate-300 mt-1 text-sm">
            Cree módulos, publique videos MP4 o enlaces y personalice sus portadas.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/dashboard"
            class="bg-slate-800 hover:bg-slate-700 text-white font-semibold py-2.5 px-5 rounded-xl transition-colors shadow-sm text-sm flex items-center justify-center gap-2 border border-slate-700"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Volver a la Galería
          </a>

          <form action="/api/auth/logout" method="POST">
            <button
              type="submit"
              class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 px-5 rounded-xl transition-colors shadow-sm text-sm flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
              Cerrar Sesión
            </button>
          </form>
        </div>
      </div>

      <!-- Crear Nueva Sección -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
          <div class="p-2 bg-blue-50 text-[#0073CF] rounded-xl border border-blue-100">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-[#06203D]">Crear Nueva Sección o Módulo</h2>
            <p class="text-xs text-slate-500">Agregue un nuevo bloque donde agrupar clases o cursos.</p>
          </div>
        </div>

        <form id="create-section-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="section-title" class="block text-xs font-semibold text-slate-700 mb-1.5">
                Título de la Sección / Módulo *
              </label>
              <input
                type="text"
                id="section-title"
                name="section-title"
                required
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0073CF] focus:bg-white text-sm"
                placeholder="Ej: Módulo 1 - Introducción al Programa"
              />
            </div>
            <div>
              <label for="section-description" class="block text-xs font-semibold text-slate-700 mb-1.5">
                Descripción Corta
              </label>
              <input
                type="text"
                id="section-description"
                name="section-description"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0073CF] focus:bg-white text-sm"
                placeholder="Breve explicación del módulo"
              />
            </div>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <button
              type="submit"
              class="bg-[#0073CF] hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-xl transition-all shadow-sm text-sm flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              Crear Sección
            </button>
            <button
              type="reset"
              class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 px-5 rounded-xl transition-colors text-sm"
            >
              Limpiar
            </button>
          </div>
          <div id="section-message" class="hidden p-4 rounded-xl text-sm font-medium"></div>
        </form>
      </div>

      <!-- Lista de Secciones y Formulario de Carga de Videos -->
      <div id="admin-sections-container" class="space-y-8">
        <div class="bg-white rounded-2xl p-12 border border-slate-200 text-center">
          <div class="animate-spin inline-block w-8 h-8 border-4 border-current border-t-transparent text-[#0073CF] rounded-full" role="status">
            <span class="sr-only">Cargando...</span>
          </div>
          <p class="text-slate-500 mt-3 text-sm font-medium">Cargando secciones de administración...</p>
        </div>
      </div>

    </div>
  </main>

  <!-- Modal Reproductor para Probar Videos en Admin -->
  <div
    id="video-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md transition-all duration-300 opacity-0"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative w-full max-w-4xl bg-slate-900 rounded-2xl shadow-2xl overflow-hidden border border-slate-800 flex flex-col max-h-[90vh] transform scale-95 transition-transform duration-300">
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950">
        <div class="flex items-center gap-3">
          <span class="bg-[#0073CF] text-white p-2 rounded-xl">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg>
          </span>
          <h3 id="modal-video-title" class="text-lg font-bold text-white truncate max-w-lg">
            Reproduciendo Video (Vista Previa Admin)
          </h3>
        </div>
        <button
          id="close-modal-btn"
          class="text-slate-400 hover:text-white p-2 rounded-xl hover:bg-slate-800 transition-colors"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div id="modal-video-container" class="aspect-video w-full bg-black flex items-center justify-center">
      </div>

      <div class="p-6 bg-slate-900 border-t border-slate-800">
        <h4 class="text-white font-semibold mb-1 text-base" id="modal-video-subtitle"></h4>
        <p id="modal-video-desc" class="text-slate-300 text-sm leading-relaxed whitespace-pre-line"></p>
      </div>
    </div>
  </div>

  <!-- Modal para gestionar adjuntos -->
  <div id="attachments-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <h3 class="text-lg font-bold text-[#06203D]">Gestionar Adjuntos</h3>
        <button id="close-attachments-btn" class="text-slate-400 hover:text-slate-600 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="p-6 overflow-y-auto flex-1 space-y-6">
        <!-- Lista de adjuntos actuales -->
        <div>
          <h4 class="text-sm font-semibold text-slate-700 mb-3">Adjuntos Actuales</h4>
          <div id="attachments-list" class="space-y-2">
            <p class="text-xs text-slate-400 italic">Cargando...</p>
          </div>
        </div>
        
        <!-- Formulario para nuevo adjunto -->
        <div class="bg-blue-50/50 p-4 rounded-xl border border-blue-100">
          <h4 class="text-sm font-semibold text-[#06203D] mb-3">Subir Nuevo Adjunto</h4>
          <form id="upload-attachment-form" class="space-y-3">
            <input type="hidden" id="att-video-id" value="">
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Título / Nombre del recurso *</label>
              <input type="text" id="att-title" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0073CF]" required placeholder="Ej: Diapositivas de la clase">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Archivo (PDF, ZIP, etc) o Enlace web *</label>
              <input type="file" id="att-file" class="w-full px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-[#0073CF]">
              <p class="text-[11px] text-slate-500 mt-1 mb-2">O si prefieres, pega una URL directamente:</p>
              <input type="url" id="att-url" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0073CF]" placeholder="https://...">
            </div>
            <button type="submit" id="att-submit-btn" class="w-full bg-[#0073CF] hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors text-sm shadow-sm">
              Subir Adjunto
            </button>
            <div id="att-message" class="hidden mt-2 p-2 rounded-lg text-xs font-medium text-center"></div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function getYouTubeId(url) {
      if (!url) return null;
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=|shorts\/)([^#\&\?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length === 11) ? match[2] : null;
    }

    function getVimeoId(url) {
      if (!url) return null;
      const regExp = /(?:vimeo\.com\/|^)(\d+)/;
      const match = url.match(regExp);
      return match ? match[1] : null;
    }

    function getThumbnailUrl(videoUrl, customThumb) {
      if (customThumb && customThumb.trim() !== '') return customThumb;
      const ytId = getYouTubeId(videoUrl);
      if (ytId) {
        return 'https://img.youtube.com/vi/' + ytId + '/hqdefault.jpg';
      }
      return null;
    }

    // Modal Video Player
    const modal = document.getElementById('video-modal');
    const modalContainer = document.getElementById('modal-video-container');
    const modalTitle = document.getElementById('modal-video-title');
    const modalSubtitle = document.getElementById('modal-video-subtitle');
    const modalDesc = document.getElementById('modal-video-desc');
    const closeModalBtn = document.getElementById('close-modal-btn');

    function renderVideoPlayer(videoUrl) {
      if (!videoUrl) return '<div class="text-slate-400 p-8 text-center">URL de video no disponible.</div>';

      const ytId = getYouTubeId(videoUrl);
      const vimeoId = getVimeoId(videoUrl);

      if (ytId) {
        return '<iframe class="w-full h-full border-0" src="https://www.youtube.com/embed/' + ytId + '?autoplay=1&rel=0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
      }

      if (vimeoId) {
        return '<iframe class="w-full h-full border-0" src="https://player.vimeo.com/video/' + vimeoId + '?autoplay=1" allow="autoplay; fullscreen" allowfullscreen></iframe>';
      }

      if (videoUrl.includes('drive.google.com')) {
        const driveEmbedUrl = videoUrl.replace(/\/view(\?.*)?$/, '/preview').replace(/\/edit(\?.*)?$/, '/preview');
        return '<iframe class="w-full h-full border-0" src="' + driveEmbedUrl + '" allow="autoplay" allowfullscreen></iframe>';
      }

      return '<video src="' + videoUrl + '" controls autoplay playsinline class="w-full h-full object-contain bg-black"></video>';
    }

    function openModal(video) {
      modalTitle.textContent = video.title;
      modalSubtitle.textContent = video.title;
      modalDesc.textContent = video.description || 'Sin descripción disponible.';

      modalContainer.innerHTML = renderVideoPlayer(video.video_url);

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(function() {
        modal.classList.remove('opacity-0');
        modal.querySelector('.transform').classList.remove('scale-95');
        modal.querySelector('.transform').classList.add('scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('opacity-0');
      modal.querySelector('.transform').classList.remove('scale-100');
      modal.querySelector('.transform').classList.add('scale-95');
      setTimeout(function() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modalContainer.innerHTML = '';
      }, 300);
      document.body.style.overflow = '';
    }

    closeModalBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });

    const adminSectionsContainer = document.getElementById('admin-sections-container');
    const sectionForm = document.getElementById('create-section-form');
    async function safeFetchJson(res, defaultErrorMsg = 'Error en la petición') {
      const text = await res.text();
      let data;
      try {
        data = JSON.parse(text);
      } catch (e) {
        if (!res.ok) {
          if (res.status === 413) {
            throw new Error('El archivo excede el límite de 4.5 MB de Vercel. Por favor seleccione un archivo de menor peso o utilice la opción de pegar URL.');
          }
          throw new Error(`Error del servidor (${res.status}): ${text.substring(0, 150) || defaultErrorMsg}`);
        }
        throw new Error('La respuesta del servidor no tiene un formato JSON válido.');
      }
      return data;
    }

    async function uploadFileToStorage(file) {
      // 1. Intentar subida directa mediante URL firmada (omite Vercel y su límite de 4.5MB)
      try {
        const signedRes = await fetch('/api/videos/signed-url', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fileName: file.name, fileType: file.type }),
        });

        if (signedRes.ok) {
          const signedData = await safeFetchJson(signedRes, 'Error al obtener URL firmada');
          if (signedData.signedUrl && signedData.publicUrl) {
            const uploadDirectRes = await fetch(signedData.signedUrl, {
              method: 'PUT',
              headers: {
                'Content-Type': file.type || 'application/octet-stream',
              },
              body: file,
            });

            if (uploadDirectRes.ok) {
              return signedData.publicUrl;
            }
          }
        }
      } catch (err) {
        console.warn('[Direct Upload Fallback]:', err);
      }

      // 2. Fallback a subida mediante la API proxy (para archivos pequeños)
      const formData = new FormData();
      formData.append('file', file);

      const storageRes = await fetch('/api/videos/storage', {
        method: 'POST',
        body: formData,
      });

      const storageData = await safeFetchJson(storageRes, 'Error al subir el archivo');

      if (!storageRes.ok || !storageData.publicUrl) {
        throw new Error(storageData.error || 'Error al subir el archivo a Supabase Storage');
      }

      return storageData.publicUrl;
    }

    const sectionMessageDiv = document.getElementById('section-message');

    sectionForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      sectionMessageDiv.classList.add('hidden');

      const title = document.getElementById('section-title').value;
      const description = document.getElementById('section-description').value;

      try {
        const response = await fetch('/api/videos/sections', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, description }),
        });

        const data = await safeFetchJson(response, 'Error al crear la sección');

        if (response.ok) {
          sectionMessageDiv.className = 'p-4 rounded-xl text-sm bg-green-100 text-green-800 border border-green-200 mt-4';
          sectionMessageDiv.textContent = 'Sección creada exitosamente';
          sectionForm.reset();
          loadAdminSections();
        } else {
          sectionMessageDiv.className = 'p-4 rounded-xl text-sm bg-red-100 text-red-800 border border-red-200 mt-4';
          sectionMessageDiv.textContent = 'Error: ' + data.error;
        }
        sectionMessageDiv.classList.remove('hidden');
      } catch (error) {
        sectionMessageDiv.className = 'p-4 rounded-xl text-sm bg-red-100 text-red-800 border border-red-200 mt-4';
        sectionMessageDiv.textContent = 'Error: ' + error.message;
        sectionMessageDiv.classList.remove('hidden');
      }
    });

    async function loadAdminSections() {
      try {
        const sectionsRes = await fetch('/api/videos/sections');
        const sectionsData = await safeFetchJson(sectionsRes, 'Error al obtener secciones');

        if (!sectionsRes.ok || !sectionsData.sections || sectionsData.sections.length === 0) {
          adminSectionsContainer.innerHTML = '<div class="bg-white rounded-2xl p-12 border border-slate-200 text-center"><p class="text-slate-500 text-sm">No hay secciones creadas aún. Utilice el formulario superior para crear la primera sección.</p></div>';
          return;
        }

        let html = '';
        for (const section of sectionsData.sections) {
          const videosRes = await fetch('/api/videos/upload?section_id=' + section.id);
          const videosData = await safeFetchJson(videosRes, 'Error al obtener videos');
          const videos = videosData.videos || [];

          html += '<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6 transition-all" id="admin-section-' + section.id + '">';
          
          // Encabezado de la sección (con botón e icono para minimizar/expandir)
          html += '<div class="flex items-start justify-between gap-4 pb-4 border-b border-slate-100 cursor-pointer select-none toggle-section-header" data-section-id="' + section.id + '">';
          html += '<div class="flex items-center gap-3"><svg class="chevron-icon w-6 h-6 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>';
          html += '<div><h3 class="text-xl font-bold text-[#06203D]">' + section.title + '</h3>';
          if (section.description) {
            html += '<p class="text-slate-500 text-sm mt-1">' + section.description + '</p>';
          }
          html += '</div></div>';

          html += '<div class="flex items-center gap-3 shrink-0" onclick="event.stopPropagation()">';
          html += '<span class="bg-slate-100 text-slate-700 text-xs font-semibold px-3 py-1.5 rounded-full border border-slate-200">' + videos.length + ' videos</span>';
          html += '<button class="toggle-section-btn bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-3 py-1.5 rounded-xl text-xs transition border border-slate-300 flex items-center gap-1" data-section-id="' + section.id + '"><span class="toggle-text">Minimizar</span></button>';
          html += '<button class="delete-section-btn bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 font-semibold px-3.5 py-1.5 rounded-xl text-xs transition flex items-center gap-1" data-section-id="' + section.id + '"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg> Eliminar Sección</button>';
          html += '</div></div>';

          // Contenedor del módulo colapsable (Formulario + Lista de videos)
          html += '<div class="section-content space-y-6" id="section-content-' + section.id + '">';

          // Formulario Subir Video + Imagen de Portada en esta sección
          html += '<div class="bg-slate-50 rounded-xl p-6 border border-slate-200"><h4 class="font-bold text-[#06203D] text-sm mb-4 flex items-center gap-2"><svg class="w-4 h-4 text-[#0073CF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Publicar Video en esta Sección</h4>';
          html += '<form class="upload-video-form space-y-4" data-section-id="' + section.id + '">';
          html += '<div><label class="block text-xs font-medium text-slate-700 mb-1">Título del Video *</label><input type="text" class="video-title w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-[#0073CF] focus:border-transparent" placeholder="Ej: Clase 1 - Conceptos clave" required /></div>';
          
          // Bloque Origen del Video
          html += '<div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-white p-4 rounded-xl border border-slate-200">';
          html += '<div><label class="block text-xs font-semibold text-[#06203D] mb-1">📁 Archivo de Video MP4 (desde tu equipo)</label><input type="file" class="video-file w-full px-3 py-1.5 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-[#0073CF]" accept="video/mp4,video/webm,video/ogg" /><p class="text-[11px] text-slate-400 mt-1">Sube archivos MP4, WebM u OGG.</p></div>';
          html += '<div><label class="block text-xs font-semibold text-[#06203D] mb-1">🔗 O pega la URL del Video</label><input type="url" class="video-url w-full px-3.5 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-[#0073CF]" placeholder="https://youtube.com/watch?v=... o enlace web" /><p class="text-[11px] text-slate-400 mt-1">Enlace de YouTube, Vimeo o video externo.</p></div>';
          html += '</div>';

          // Bloque Imagen de Portada / Miniatura
          html += '<div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-blue-50/50 p-4 rounded-xl border border-blue-100">';
          html += '<div><label class="block text-xs font-semibold text-[#06203D] mb-1">🖼️ Imagen de Portada / Vista Previa (Opcional)</label><input type="file" class="thumb-file w-full px-3 py-1.5 bg-white border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-[#0073CF]" accept="image/png,image/jpeg,image/webp,image/jpg" /><p class="text-[11px] text-slate-500 mt-1">Sube una imagen JPG, PNG o WebP desde tu equipo.</p></div>';
          html += '<div><label class="block text-xs font-semibold text-[#06203D] mb-1">🔗 O pega la URL de la Imagen de Portada</label><input type="url" class="thumb-url w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-[#0073CF]" placeholder="https://ejemplo.com/portada.jpg" /><p class="text-[11px] text-slate-500 mt-1">Se usará como miniatura en la tarjeta del video.</p></div>';
          html += '</div>';

          html += '<div><label class="block text-xs font-medium text-slate-700 mb-1">Descripción del Video</label><textarea class="video-description w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-[#0073CF] focus:border-transparent" placeholder="Detalles adicionales o resumen del contenido" rows="2"></textarea></div>';
          html += '<div class="flex items-center gap-3 pt-1"><button type="submit" class="submit-btn bg-[#0073CF] hover:bg-blue-700 text-white font-semibold py-2 px-5 rounded-xl transition-colors shadow-sm text-sm">Publicar Video</button><button type="reset" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold py-2 px-4 rounded-xl transition-colors text-sm">Limpiar Formulario</button></div>';
          html += '<div class="video-message hidden p-3 rounded-xl text-xs font-medium"></div></form></div>';

          // Lista de Videos Publicados en esta sección
          html += '<div><h4 class="font-bold text-[#06203D] text-sm mb-4">Videos subidos a este módulo</h4>';
          if (videos.length > 0) {
            html += '<div class="space-y-3">';
            videos.forEach(function(video) {
              const thumb = getThumbnailUrl(video.video_url, video.thumbnail_url);
              const jsonVideo = JSON.stringify(video).replace(/'/g, "&apos;").replace(/"/g, '&quot;');

              html += '<div class="bg-slate-50 rounded-xl p-4 border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:border-slate-300 transition-all">';
              html += '<div class="flex items-center gap-4 flex-1 min-w-0">';
              
              if (thumb) {
                html += '<div class="relative w-24 h-14 rounded-lg overflow-hidden bg-slate-800 flex-shrink-0 group cursor-pointer play-trigger" data-video=\'' + jsonVideo + '\'><img src="' + thumb + '" alt="' + video.title + '" class="w-full h-full object-cover group-hover:scale-105 transition-transform" /><div class="absolute inset-0 bg-black/40 flex items-center justify-center group-hover:bg-black/20 transition"><svg class="w-6 h-6 text-white drop-shadow" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg></div></div>';
              } else {
                html += '<div class="w-24 h-14 rounded-lg bg-[#06203D] flex items-center justify-center flex-shrink-0 cursor-pointer play-trigger" data-video=\'' + jsonVideo + '\'><svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg></div>';
              }

              html += '<div class="min-w-0"><h5 class="font-bold text-[#06203D] text-sm truncate">' + video.title + '</h5>';
              if (video.description) {
                html += '<p class="text-slate-500 text-xs truncate mt-0.5">' + video.description + '</p>';
              }
              html += '<button class="text-[#0073CF] text-xs font-semibold hover:underline mt-1 inline-flex items-center gap-1 play-trigger" data-video=\'' + jsonVideo + '\'><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg> Probar Vista Previa</button></div></div>';
              html += '<div class="flex items-center gap-2 self-end sm:self-center">';
              html += '<button class="manage-attachments-btn bg-slate-200 hover:bg-slate-300 text-slate-800 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1 shadow-sm" data-video-id="' + video.id + '"><svg class="w-3.5 h-3.5 text-[#0073CF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg> Adjuntos</button>';
              html += '<button class="delete-video-btn bg-red-600 hover:bg-red-700 text-white px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1 shadow-sm" data-video-id="' + video.id + '"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg> Eliminar</button>';
              html += '</div></div>';
            });
            html += '</div>';
          } else {
            html += '<p class="text-slate-400 text-sm italic bg-slate-50 p-4 rounded-xl border border-slate-100">No hay videos en esta sección aún.</p>';
          }

          html += '</div></div></div>';
        }

        adminSectionsContainer.innerHTML = html;

        // Asignar eventos de minimizar/expandir módulos
        document.querySelectorAll('.toggle-section-header, .toggle-section-btn').forEach(function(el) {
          el.addEventListener('click', function(e) {
            const sectionId = el.getAttribute('data-section-id');
            const container = document.getElementById('admin-section-' + sectionId);
            const content = document.getElementById('section-content-' + sectionId);
            const btn = container?.querySelector('.toggle-section-btn');
            const textSpan = btn?.querySelector('.toggle-text');
            const icon = container?.querySelector('.chevron-icon');

            if (content) {
              const isHidden = content.classList.toggle('hidden');
              if (textSpan) {
                textSpan.textContent = isHidden ? 'Expandir' : 'Minimizar';
              }
              if (icon) {
                if (isHidden) {
                  icon.classList.add('-rotate-90');
                } else {
                  icon.classList.remove('-rotate-90');
                }
              }
            }
          });
        });

        document.querySelectorAll('.play-trigger').forEach(function(el) {
          el.addEventListener('click', function() {
            const videoData = JSON.parse(el.getAttribute('data-video'));
            openModal(videoData);
          });
        });

        document.querySelectorAll('.upload-video-form').forEach(function(form) {
          form.addEventListener('submit', handleVideoUpload);
        });

        document.querySelectorAll('.delete-section-btn').forEach(function(btn) {
          btn.addEventListener('click', handleSectionDelete);
        });

        document.querySelectorAll('.delete-video-btn').forEach(function(btn) {
          btn.addEventListener('click', handleVideoDelete);
        });

      } catch (error) {
        adminSectionsContainer.innerHTML = '<div class="bg-red-50 text-red-700 p-6 rounded-2xl text-sm border border-red-200">Error al cargar contenido: ' + error.message + '</div>';
      }
    }

    async function handleVideoUpload(e) {
      e.preventDefault();
      const form = e.target;
      const sectionId = form.dataset.sectionId;
      const title = form.querySelector('.video-title').value;
      const fileInput = form.querySelector('.video-file');
      let video_url = form.querySelector('.video-url').value.trim();

      const thumbFileInput = form.querySelector('.thumb-file');
      let thumbnail_url = form.querySelector('.thumb-url').value.trim() || null;

      const description = form.querySelector('.video-description').value;
      const messageDiv = form.querySelector('.video-message');
      const submitBtn = form.querySelector('.submit-btn');

      messageDiv.classList.add('hidden');

      const videoFile = fileInput?.files?.[0];
      const thumbFile = thumbFileInput?.files?.[0];

      if (!videoFile && !video_url) {
        messageDiv.className = 'video-message p-3 rounded-xl text-xs font-medium bg-red-100 text-red-800 border border-red-200';
        messageDiv.textContent = 'Seleccione un archivo de video MP4 o ingrese una URL de video.';
        messageDiv.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Procesando y subiendo contenido...';

      try {
        // 1. Si seleccionó archivo de video MP4 local, subir directamente a Supabase Storage
        if (videoFile) {
          video_url = await uploadFileToStorage(videoFile);
        }

        // 2. Si seleccionó archivo de imagen de portada local, subir directamente a Supabase Storage
        if (thumbFile) {
          thumbnail_url = await uploadFileToStorage(thumbFile);
        }

        // 3. Publicar el video en la base de datos
        const response = await fetch('/api/videos/upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ section_id: sectionId, title, video_url, thumbnail_url, description }),
        });

        const data = await safeFetchJson(response, 'Error al guardar el video en la base de datos');

        if (response.ok) {
          messageDiv.className = 'video-message p-3 rounded-xl text-xs font-medium bg-green-100 text-green-800 border border-green-200';
          messageDiv.textContent = 'Video publicado exitosamente';
          form.reset();
          loadAdminSections();
        } else {
          messageDiv.className = 'video-message p-3 rounded-xl text-xs font-medium bg-red-100 text-red-800 border border-red-200';
          messageDiv.textContent = 'Error: ' + data.error;
          messageDiv.classList.remove('hidden');
        }
      } catch (error) {
        messageDiv.className = 'video-message p-3 rounded-xl text-xs font-medium bg-red-100 text-red-800 border border-red-200';
        messageDiv.textContent = 'Error: ' + error.message;
        messageDiv.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Publicar Video';
      }
    }

    async function handleVideoDelete(e) {
      const btn = e.currentTarget;
      const videoId = btn.getAttribute('data-video-id');

      if (!confirm('¿Estás seguro de que deseas eliminar este video?')) return;

      try {
        const response = await fetch('/api/videos/upload?id=' + videoId, {
          method: 'DELETE',
        });

        const data = await safeFetchJson(response, 'Error al eliminar el video');

        if (response.ok) {
          loadAdminSections();
        } else {
          alert('Error al eliminar el video: ' + data.error);
        }
      } catch (error) {
        alert('Error al eliminar el video: ' + error.message);
      }
    }

    async function handleSectionDelete(e) {
      const btn = e.currentTarget;
      const sectionId = btn.getAttribute('data-section-id');

      if (!confirm('¿Estás seguro de eliminar esta sección? Se eliminarán también todos los videos contenidos en ella.')) return;

      try {
        const response = await fetch('/api/videos/sections?id=' + sectionId, {
          method: 'DELETE',
        });

        const data = await safeFetchJson(response, 'Error al eliminar la sección');

        if (response.ok) {
          loadAdminSections();
        } else {
          alert('Error al eliminar la sección: ' + data.error);
        }
      } catch (error) {
        alert('Error al eliminar la sección: ' + error.message);
      }
    }

    // Modal Attachments Logic
    const attModal = document.getElementById('attachments-modal');
    const attList = document.getElementById('attachments-list');
    const attForm = document.getElementById('upload-attachment-form');
    const attMessage = document.getElementById('att-message');
    const attVideoIdInput = document.getElementById('att-video-id');

    document.getElementById('close-attachments-btn').addEventListener('click', () => {
      attModal.classList.add('opacity-0');
      setTimeout(() => attModal.classList.add('hidden'), 300);
    });

    async function openAttachmentsModal(videoId) {
      attVideoIdInput.value = videoId;
      attModal.classList.remove('hidden');
      setTimeout(() => attModal.classList.remove('opacity-0'), 10);
      loadAttachments(videoId);
    }

    async function loadAttachments(videoId) {
      attList.innerHTML = '<p class="text-xs text-slate-400 italic">Cargando...</p>';
      try {
        const res = await fetch('/api/videos/attachments?video_id=' + videoId);
        const data = await res.json();
        if (data.attachments && data.attachments.length > 0) {
          let html = '';
          data.attachments.forEach(att => {
            html += '<div class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-lg shadow-sm">';
            html += '<div class="flex items-center gap-2 overflow-hidden">';
            html += '<svg class="w-4 h-4 text-[#0073CF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>';
            html += '<a href="' + att.file_url + '" target="_blank" class="text-sm font-semibold text-slate-800 hover:text-[#0073CF] truncate">' + att.title + '</a>';
            html += '</div>';
            html += '<button type="button" class="delete-att-btn text-red-500 hover:text-red-700 p-1 rounded transition-colors" data-id="' + att.id + '"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>';
            html += '</div>';
          });
          attList.innerHTML = html;
        } else {
          attList.innerHTML = '<p class="text-xs text-slate-500 italic">No hay adjuntos en este video.</p>';
        }
      } catch (error) {
        attList.innerHTML = '<p class="text-xs text-red-500">Error al cargar adjuntos.</p>';
      }
    }

    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.delete-att-btn');
      if (btn) {
        if (!confirm('¿Eliminar este adjunto?')) return;
        const id = btn.getAttribute('data-id');
        try {
          await fetch('/api/videos/attachments?id=' + id, { method: 'DELETE' });
          loadAttachments(attVideoIdInput.value);
        } catch (error) {
          alert('Error: ' + error.message);
        }
      }

      const openBtn = e.target.closest('.manage-attachments-btn');
      if (openBtn) {
        openAttachmentsModal(openBtn.getAttribute('data-video-id'));
      }
    });

    attForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const videoId = attVideoIdInput.value;
      const title = document.getElementById('att-title').value;
      const fileInput = document.getElementById('att-file');
      let file_url = document.getElementById('att-url').value;

      attMessage.classList.add('hidden');
      const submitBtn = document.getElementById('att-submit-btn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Subiendo...';

      try {
        if (fileInput.files.length > 0) {
          file_url = await uploadFileToStorage(fileInput.files[0]);
        }
        
        if (!file_url) {
          throw new Error('Debes seleccionar un archivo o ingresar un enlace.');
        }

        const res = await fetch('/api/videos/attachments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ video_id: videoId, title, file_url })
        });
        
        const data = await res.json();
        if (data.error) throw new Error(data.error);

        attForm.reset();
        document.getElementById('att-video-id').value = videoId;
        loadAttachments(videoId);
      } catch (error) {
        attMessage.textContent = error.message;
        attMessage.classList.remove('hidden');
        attMessage.classList.add('bg-red-100', 'text-red-700');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Subir Adjunto';
      }
    });

    loadAdminSections();
  </script>
</Layout>
