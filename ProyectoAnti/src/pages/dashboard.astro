---
import Layout from "../layouts/Layout.astro";

const user = Astro.locals.user;
---

<Layout>
  <main class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h1 class="text-2xl font-bold text-[#06203D]">Panel de Control</h1>
            <p class="text-slate-500 mt-1">Bienvenido, {user?.email || 'Usuario'}</p>
          </div>
          <form action="/api/auth/logout" method="POST">
            <button
              type="submit"
              class="bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors"
            >
              Cerrar Sesión
            </button>
          </form>
        </div>

        <div class="space-y-6">
          <div class="bg-slate-50 rounded-lg p-6">
            <h2 class="text-lg font-semibold text-[#06203D] mb-3">Información de la Cuenta</h2>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-slate-500">Email</dt>
                <dd class="font-medium text-[#06203D]">{user?.email}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500">ID de Usuario</dt>
                <dd class="font-medium text-[#06203D] font-mono text-xs">{user?.id}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500">Proveedor</dt>
                <dd class="font-medium text-[#06203D]">{user?.app_metadata?.provider || 'email'}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500">Creado</dt>
                <dd class="font-medium text-[#06203D]">{user?.created_at ? new Date(user.created_at).toLocaleDateString('es-ES') : 'N/A'}</dd>
              </div>
            </dl>
          </div>

          <div class="bg-slate-50 rounded-lg p-6">
            <h2 class="text-lg font-semibold text-[#06203D] mb-3">Acciones Rápidas</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              <a href="#" class="block p-4 bg-white border border-slate-200 rounded-lg hover:border-[#0073CF] hover:shadow-md transition-all">
                <h3 class="font-semibold text-[#06203D]">Subir Video</h3>
                <p class="text-sm text-slate-500 mt-1">Agregar nuevo contenido</p>
              </a>
              <a href="#" class="block p-4 bg-white border border-slate-200 rounded-lg hover:border-[#0073CF] hover:shadow-md transition-all">
                <h3 class="font-semibold text-[#06203D]">Gestión de Usuarios</h3>
                <p class="text-sm text-slate-500 mt-1">Administrar accesos</p>
              </a>
              <a href="#" class="block p-4 bg-white border border-slate-200 rounded-lg hover:border-[#0073CF] hover:shadow-md transition-all">
                <h3 class="font-semibold text-[#06203D]">Configuración</h3>
                <p class="text-sm text-slate-500 mt-1">Ajustes del sistema</p>
              </a>
              <a href="#" class="block p-4 bg-white border border-slate-200 rounded-lg hover:border-[#0073CF] hover:shadow-md transition-all">
                <h3 class="font-semibold text-[#06203D]">Reportes</h3>
                <p class="text-sm text-slate-500 mt-1">Ver estadísticas</p>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>