---
import Layout from "../layouts/Layout.astro";

const redirect = Astro.url.searchParams.get("redirect") || "/dashboard";
const error = Astro.url.searchParams.get("error");
---

<Layout>
  <main class="h-[100dvh] overflow-hidden w-full flex flex-col md:flex-row">
    <!-- Mitad Izquierda (Logo y Branding) -->
    <div
      class="hidden md:flex w-1/2 bg-[#06203D] flex-col items-center justify-center p-12"
    >
      <div class="max-w-lg text-center">
        <img
          src="/Logo-Instituto-Antipobreza-Argentina.png"
          alt="Logo Instituto Antipobreza"
          class="w-full h-auto object-contain mx-auto mb-8"
        />
        <h2 class="text-3xl font-bold text-white mb-4">
          Instituto Antipobreza Argentina
        </h2>
        <p class="text-slate-300 text-lg">
          Acceda a las herramientas internas del Instituto Antipobreza de manera
          segura y eficiente.
        </p>
      </div>
    </div>

    <!-- Mitad Derecha (Formulario) -->
    <div
      class="w-full md:w-1/2 bg-white flex flex-1 items-center justify-center p-8 sm:p-12"
    >
      <div class="w-full max-w-md">
        <!-- Encabezado Móvil -->
        <div class="md:hidden text-center mb-8">
          <img
            src="/Logo-Instituto-Antipobreza-Argentina.png"
            alt="Logo Instituto Antipobreza"
            class="w-full h-auto object-contain mx-auto mb-4"
          />
        </div>

        <div class="mb-10 text-center md:text-left">
          <h1 id="auth-title" class="text-3xl font-bold text-[#06203D] mb-3">
            Iniciar Sesión
          </h1>
          <p id="auth-subtitle" class="text-slate-500">
            Ingrese sus credenciales para acceder al panel
          </p>
        </div>

        {
          error && (
            <div
              class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm"
              role="alert"
            >
              {error === "oauth_failed"
                ? "Error al iniciar sesión con Google. Intente nuevamente."
                : decodeURIComponent(error)}
            </div>
          )
        }

        <!-- Botón Google OAuth y Separador -->
        <div id="google-container">
          <a
            href={`/api/auth/google?next=${encodeURIComponent(redirect)}`}
            class="w-full flex items-center justify-center gap-3 px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-700 font-semibold hover:bg-slate-50 hover:border-[#0073CF] transition-all shadow-sm"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              ></path>
              <path
                fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path>
              <path
                fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
              ></path>
              <path
                fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              ></path>
            </svg>
            <span>Continuar con Google</span>
          </a>

          <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-slate-300"></div>
            </div>
            <div class="relative flex justify-center text-sm">
              <span class="px-2 bg-white text-slate-500"
                >o continúa con email</span
              >
            </div>
          </div>
        </div>

        <!-- Formulario Email/Password -->
        <form
          id="login-form"
          class="space-y-6"
          data-redirect={redirect}
          data-mode="login"
          novalidate
        >
          <div>
            <label
              for="email"
              class="block text-sm font-semibold text-[#06203D] mb-2"
            >
              Correo Electrónico
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-[#06203D] focus:outline-none focus:ring-2 focus:ring-[#0073CF] focus:bg-white transition-all shadow-sm"
              placeholder="correo@institutoantipobreza.org"
            />
          </div>

          <div id="password-field">
            <div class="flex items-center justify-between mb-2">
              <label
                for="password"
                class="block text-sm font-semibold text-[#06203D]"
              >
                Contraseña
              </label>
              <button
                type="button"
                id="forgot-password-btn"
                class="text-xs text-[#0073CF] hover:underline font-semibold"
              >
                ¿Olvidaste tu contraseña?
              </button>
            </div>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-[#06203D] focus:outline-none focus:ring-2 focus:ring-[#0073CF] focus:bg-white transition-all shadow-sm"
              placeholder="••••••••"
            />
          </div>

          <div id="confirm-password-field" class="hidden">
            <label
              for="confirm-password"
              class="block text-sm font-semibold text-[#06203D] mb-2"
            >
              Confirmar Contraseña
            </label>
            <input
              type="password"
              id="confirm-password"
              name="confirm-password"
              autocomplete="new-password"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-[#06203D] focus:outline-none focus:ring-2 focus:ring-[#0073CF] focus:bg-white transition-all shadow-sm"
              placeholder="••••••••"
            />
          </div>

          <div class="pt-4">
            <button
              type="submit"
              id="login-btn"
              class="w-full bg-[#06203D] hover:bg-[#0073CF] text-white font-semibold py-3 px-4 rounded-lg transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="submit-label">Ingresar</span>
            </button>
          </div>
        </form>

        <div
          id="login-error"
          class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm"
          role="alert"
        >
        </div>
        <p class="mt-6 flex items-center justify-center gap-1.5 text-sm text-slate-500">
          <span id="auth-switch-text">¿No tienes una cuenta?</span>
          <button
            type="button"
            id="auth-switch"
            class="font-semibold text-[#0073CF] hover:underline"
          >
            Crear una cuenta
          </button>
        </p>
      </div>
    </div>
  </main>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement;
    const btn = document.getElementById("login-btn") as HTMLButtonElement;
    const errorDiv = document.getElementById("login-error") as HTMLDivElement;
    const switchButton = document.getElementById(
      "auth-switch",
    ) as HTMLButtonElement;
    const switchText = document.getElementById(
      "auth-switch-text",
    ) as HTMLSpanElement;
    const forgotBtn = document.getElementById(
      "forgot-password-btn",
    ) as HTMLButtonElement;
    const title = document.getElementById("auth-title") as HTMLHeadingElement;
    const subtitle = document.getElementById(
      "auth-subtitle",
    ) as HTMLParagraphElement;
    const submitLabel = document.getElementById(
      "submit-label",
    ) as HTMLSpanElement;
    const googleContainer = document.getElementById(
      "google-container",
    ) as HTMLDivElement;
    const passwordField = document.getElementById(
      "password-field",
    ) as HTMLDivElement;
    const passwordInput = document.getElementById(
      "password",
    ) as HTMLInputElement;
    const confirmField = document.getElementById(
      "confirm-password-field",
    ) as HTMLDivElement;
    const confirmPassword = document.getElementById(
      "confirm-password",
    ) as HTMLInputElement;
    const redirectUrl = form?.dataset.redirect || "/dashboard";

    function setMode(mode: "login" | "signup" | "forgot") {
      form.dataset.mode = mode;
      errorDiv.classList.add("hidden");

      if (mode === "login") {
        title.textContent = "Iniciar Sesión";
        subtitle.textContent = "Ingrese sus credenciales para acceder al panel";
        submitLabel.textContent = "Ingresar";
        switchText.textContent = "¿No tienes una cuenta?";
        switchButton.textContent = "Crear una cuenta";
        googleContainer.classList.remove("hidden");
        passwordField.classList.remove("hidden");
        confirmField.classList.add("hidden");
        passwordInput.required = true;
        confirmPassword.required = false;
      } else if (mode === "signup") {
        title.textContent = "Crear una cuenta";
        subtitle.textContent = "Regístrese para acceder al panel";
        submitLabel.textContent = "Crear cuenta";
        switchText.textContent = "¿Ya tienes una cuenta?";
        switchButton.textContent = "Iniciar sesión";
        googleContainer.classList.remove("hidden");
        passwordField.classList.remove("hidden");
        confirmField.classList.remove("hidden");
        passwordInput.required = true;
        confirmPassword.required = true;
      } else if (mode === "forgot") {
        title.textContent = "Restablecer Contraseña";
        subtitle.textContent =
          "Ingrese su correo electrónico para recibir las instrucciones de recuperación";
        submitLabel.textContent = "Enviar enlace de recuperación";
        switchText.textContent = "¿Recordaste tu contraseña?";
        switchButton.textContent = "Volver a iniciar sesión";
        googleContainer.classList.add("hidden");
        passwordField.classList.add("hidden");
        confirmField.classList.add("hidden");
        passwordInput.required = false;
        confirmPassword.required = false;
      }
    }

    switchButton?.addEventListener("click", () => {
      const currentMode = form.dataset.mode;
      if (currentMode === "forgot" || currentMode === "signup") {
        setMode("login");
      } else {
        setMode("signup");
      }
    });

    forgotBtn?.addEventListener("click", () => {
      setMode("forgot");
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorDiv.classList.add("hidden");
      errorDiv.textContent = "";

      const email = form.email.value.trim();
      const password = form.password.value;
      const mode = form.dataset.mode;

      if (!email) {
        errorDiv.textContent = "Por favor ingrese su correo electrónico";
        errorDiv.className =
          "mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm";
        errorDiv.classList.remove("hidden");
        return;
      }

      if (mode !== "forgot" && !password) {
        errorDiv.textContent = "Por favor ingrese su contraseña";
        errorDiv.className =
          "mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm";
        errorDiv.classList.remove("hidden");
        return;
      }

      if (mode === "signup" && password !== confirmPassword.value) {
        errorDiv.textContent = "Las contraseñas no coinciden";
        errorDiv.className =
          "mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm";
        errorDiv.classList.remove("hidden");
        return;
      }

      btn.disabled = true;
      if (mode === "login") submitLabel.textContent = "Ingresando...";
      else if (mode === "signup") submitLabel.textContent = "Creando cuenta...";
      else submitLabel.textContent = "Enviando...";

      try {
        let endpoint = "/api/auth/login";
        let bodyPayload: any = { email, password };

        if (mode === "signup") {
          endpoint = "/api/auth/signup";
        } else if (mode === "forgot") {
          endpoint = "/api/auth/forgot-password";
          bodyPayload = { email };
        }

        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(bodyPayload),
        });

        const responseText = await res.text();
        let data: any = {};
        if (responseText) {
          try {
            data = JSON.parse(responseText);
          } catch {
            data = { error: "Respuesta del servidor no válida" };
          }
        }

        if (!res.ok) {
          throw new Error(data.error || "Error en la solicitud");
        }

        if (mode === "login") {
          window.location.href = redirectUrl;
        } else if (mode === "signup") {
          if (data.session) {
            window.location.href = redirectUrl;
          } else {
            errorDiv.textContent =
              "¡Cuenta creada con éxito! Si requiere confirmación por email, revisa tu correo.";
            errorDiv.className =
              "mt-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm";
            errorDiv.classList.remove("hidden");
            form.reset();
          }
        } else if (mode === "forgot") {
          errorDiv.textContent =
            data.message ||
            "Le hemos enviado un correo con instrucciones para restablecer su contraseña.";
          errorDiv.className =
            "mt-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm";
          errorDiv.classList.remove("hidden");
        }
      } catch (err) {
        errorDiv.textContent =
          err instanceof Error ? err.message : "Error de autenticación";
        errorDiv.className =
          "mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm";
        errorDiv.classList.remove("hidden");
      } finally {
        btn.disabled = false;
        if (mode === "login") submitLabel.textContent = "Ingresar";
        else if (mode === "signup") submitLabel.textContent = "Crear cuenta";
        else submitLabel.textContent = "Enviar enlace de recuperación";
      }
    });
  </script>
</Layout>
